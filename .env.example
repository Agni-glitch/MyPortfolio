# Copy to `.env` for local development. On Vercel, set these in
# Project Settings -> Environment Variables. NEVER commit real values.

# --- Database (MongoDB Atlas) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=portfolio

# --- Media (Cloudinary) ---
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=portfolio

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=you@example.com

# --- Email (OTP delivery + contact notifications) ---
# For Gmail: enable 2FA and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=you@example.com
SMTP_PASSWORD=your-app-password

# --- Site ---
# Optional on Vercel: if unset, the project's production *.vercel.app domain is used.
SITE_URL=http://localhost:8000
SITE_NAME=My Portfolio
# "development" disables the Secure cookie flag so login works over http://localhost
ENVIRONMENT=development
